{
  "name": "Chrome 320 Publish Watch",
  "description": "Every 2 hours, publish the staged KJB Reader v0.4.320 to the Chrome Web Store once its review approves. Stops automatically after 24 runs.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */2 * * *",
      "one_time_date": null,
      "timezone": "Asia/Singapore",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 24
    }
  },
  "definition": {
    "do": [
      {
        "retry_publish": {
          "call": "invoke_superagent_step",
          "then": "end",
          "with": {
            "message": "Scheduled check: publish KJB Reader v0.4.320 to the Chrome Web Store now that it has been submitted.\n\nRun: cd /app && set -a && source .agents/.env && set +a && bash scripts/publish-chrome.sh build/kjb-reader-chrome-v0.4.320.zip --submit --auto-publish\n\nContext: v0.4.320 was submitted to the Chrome Web Store in STAGED_PUBLISH mode on 2026-10-22 (PENDING_REVIEW). While the review is pending, the publish call fails with 'You may not edit or publish an item that is in review.' \u2014 that is the expected transient state, not a bug. Once review approves, the publish call releases the staged version to all users.\n\nIf the script output shows the submission was accepted and will publish automatically, or that the version is already PUBLISHED: report the publication to the owner, then deactivate this workflow (name: Chrome 320 Publish Watch) so it stops firing.\nIf it still fails with the in-review error: reply briefly that the review is still pending, and let the workflow fire again. Do not deactivate.\nIf it fails with a DIFFERENT error: investigate, report to the owner, and deactivate this workflow so it stops firing."
          },
          "x-base44": {
            "description": "Publish staged v0.4.320 after review approval",
            "title": "Publish Chrome v0.4.320"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "chrome_320_publish_watch",
      "namespace": "base44",
      "version": "1"
    }
  }
}